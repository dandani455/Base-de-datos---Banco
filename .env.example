# Variables del stack completo (docker-compose.yml de la raíz).
# Copia este archivo a .env y cambia los valores. .env NO se versiona.

# --- Base de datos ---
# Clave del superusuario "postgres" del contenedor (usuario y base son fijos: postgres / banco).
# El backend NO usa esta clave: entra como banco_app (clave de desarrollo de db/sql/01_roles.sql).
POSTGRES_PASSWORD=cambia-esto
# Semilla al crear el volumen: demo (12 usuarios ficticios + admin1, clave Banco2026), catalogo (solo CDT y créditos) o ninguno
SEED=demo

# --- Backend ---
# Cadena larga y aleatoria, p. ej.: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
BCRYPT_ROUNDS=10
# true solo si se sirve por HTTPS (con http://localhost la cookie secure no se guarda y el login falla)
COOKIE_SECURE=false
# URL pública del front (se usa en el enlace del correo de verificación). Debe coincidir con FRONT_PORT.
APP_URL=http://localhost:8080

# --- Correo (Resend). false = sin verificación; el bono de referido se paga al registrar ---
RESEND_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=Banco Digital <onboarding@resend.dev>

# --- Puertos del host ---
FRONT_PORT=8080
PGADMIN_PORT=5050
# PostgreSQL solo en 127.0.0.1 (psql / pruebas desde el host)
DB_PORT=5433
