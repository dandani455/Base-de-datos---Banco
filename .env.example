# --- Base de datos ---
POSTGRES_USER=banco
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=banco
# Rol de la app (solo EXECUTE sobre funciones): lo crea db/init/00_roles.sql
DATABASE_URL=postgres://banco_app:cambia-esto@db:5432/banco
# --- Backend ---
PORT=3000
NODE_ENV=production
JWT_SECRET=cadena-larga-aleatoria
BCRYPT_ROUNDS=10
# true solo si se sirve por HTTPS (con http://localhost la cookie secure no se guarda)
COOKIE_SECURE=false
APP_URL=http://localhost
# --- Correo (Resend). false = sin verificación; el bono de referido se paga al registrar ---
RESEND_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=Banco Digital <onboarding@resend.dev>
