# Variables del entorno de DESARROLLO LOCAL (valores no secretos).
# Copia este archivo a db/.env (ctl.ps1 up lo hace solo si no existe). db/.env NO se versiona.
# Los puertos se publican unicamente en 127.0.0.1.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=banco_dev_local

# Puerto del host para PostgreSQL. 5433 evita el choque con un PostgreSQL instalado en el equipo (5432).
DB_PORT=5433

# Puerto del host para pgAdmin 4 (http://localhost:5050).
PGADMIN_PORT=5050

# pgAdmin exige un correo valido (no se usa para iniciar sesion: corre en modo escritorio, sin login).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_local
